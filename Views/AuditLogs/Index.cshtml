@model IEnumerable<BookstoreCatalog.Mvc.Models.AuditLogs>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container mt-4">
    <h1 class="fw-bold text-dark mb-4">Audit Logs</h1>

    <div class="card shadow-sm border-0 rounded-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 15%;" class="ps-3">Time</th>
                        <th style="width: 15%;">Level</th>
                        <th style="width: 70%;">Message</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">Không có bản ghi log nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            string customStyle = log.Level switch
                            {
                                "Warning" => "color: #ff9800; font-weight: 500;",
                                "Error" => "color: #dc3545; font-weight: 500;",
                                _ => "color: #212529"
                            };

                            <tr>
                                <td class="py-3 ps-4" style="@customStyle">@log.Time.ToString("dd/MM HH:mm")</td>
                                <td class="py-3" style="@customStyle">@log.Level</td>
                                <td class="py-3" style="@customStyle">@log.Message</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>