@model BookCreateViewModel

@{
    ViewData["Title"] = "Create Book";
}

<div class="page-header">
    <h2 class="page-title">Create Book</h2>

    <a class="btn btn-light"
       asp-controller="Books"
       asp-action="Index">
        Quay lại danh sách
    </a>
</div>

<div class="form-layout">
    <form class="form-box"
          asp-controller="Books"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"></div>

        <div class="form-group">
            <label asp-for="Title">Tên sách</label>
            <input asp-for="Title"
                   class="form-control"
                   placeholder="Ví dụ: Bocchi the Rock" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Author">ISBN</label>
            <input asp-for="Author"
                   class="form-control"
                   placeholder="Ví dụ: 978-012-45-7812-9" />
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Author">Tác giả</label>
            <input asp-for="Author"
                   class="form-control"
                   placeholder="Ví dụ: Aki Hamazi" />
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CategoryId">Mã Thể loại</label>
            <input asp-for="CategoryId"
                   class="form-control"
                   placeholder="Ví dụ: 1, 2, 3,..." />
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="UnitPrice">Giá bán</label>
            <input asp-for="UnitPrice"
                   class="form-control"
                   placeholder="Ví dụ: 450000" />
            <span asp-validation-for="UnitPrice" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Quantity">Số lượng</label>
            <input asp-for="Quantity"
                   class="form-control"
                   placeholder="Ví dụ: 12" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MinStock">Mức tồn tối thiểu</label>
            <input asp-for="MinStock"
                   class="form-control"
                   placeholder="Ví dụ: 5" />
            <span asp-validation-for="MinStock" class="text-danger"></span>
        </div>

        <button class="btn" type="submit">
            Save Book
        </button>

        <a class="btn btn-secondary"
           asp-controller="Books"
           asp-action="Index">
            Back to List
        </a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}