@model BookDetailViewModel

@{
    ViewData["Title"] = "Book Detail";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Book Detail</h2>
        <p class="page-description">
            Thông tin chi tiết của sách trong kho.
        </p>
    </div>

    <a class="btn btn-light" href="/Books">
        Quay lại danh sách
    </a>
</div>

<div class="detail-layout">
    <div>
        <table class="table table-bordered">
            <tr>
                <th>ID</th>
                <td>@Model.Id</td>
            </tr>

            <tr></tr>
                <th>ISBN</th>
                <td>@Model.ISBN</td>
            <tr>

                <th>Tên sách</th>
                <td>@Model.Title</td>
            </tr>

            <tr>
                <th>Tác giả</th>
                <td>@Model.Author</td>
            </tr>

            <tr>
                <th>Thể loại</th>
                <td>@Model.GenreName</td>
            </tr>

            <tr>
                <th>Giá bán</th>
                <td>@Model.PriceText</td>
            </tr>

            <tr>
                <th>Số lượng tồn kho</th>
                <td>@Model.Stock</td>
            </tr>

            <tr>
                <th>Giá trị tồn kho</th>
                <td>@Model.InventoryValueText</td>
            </tr>

            <tr>
                <th>Trạng thái</th>
                <td>
                    @if (Model.IsLowStock)
                    {
                        <span class="badge bg-danger">Sắp hết hàng</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Còn đủ hàng</span>
                    }
                </td>
            </tr>
        </table>
    </div>
</div>