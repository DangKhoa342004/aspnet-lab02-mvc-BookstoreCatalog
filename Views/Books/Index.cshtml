@model List<BookstoreCatalog.Mvc.ViewModels.BookListViewModel>

@{
    ViewData["Title"] = "Book Catalog";
    var totalItems = Model.Count;
}

<div class="page-header">
    <div>
        <h2 class="dashboard-title">Data Layer Dashboard</h2>
        <div class="flow-steps">
            <div class="step-card">Controller</div>
            <div class="flow-arrow">&rarr;</div>
            <div class="step-card">Service</div>
            <div class="flow-arrow">&rarr;</div>
            <div class="step-card">Repository</div>
            <div class="flow-arrow">&rarr;</div>
            <div class="step-card">DbContext</div>
            <div class="flow-arrow">&rarr;</div>
            <div class="step-card">Database</div>
        </div>
    </div>

    <div>
        <a class="btn btn-secondary" asp-controller="Books" asp-action="Search"> Search Book</a>

        <a class="btn btn-warning" asp-controller="Books" asp-action="Create"> Add New Book</a>
    </div>
    
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-box">
        @TempData["SuccessMessage"]
    </div>
}

<div class="info-box">
    <strong>Tổng số sách:</strong> @totalItems
</div>

@if (Model.Count == 0)
{
    <p>Chưa có sách nào trong hệ thống.</p>
}
else
{
    <div class="product-grid">
        @foreach (var item in Model)
        {
            <partial name="_BookCard" model="item" />
        }
    </div>
}