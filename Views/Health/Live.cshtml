@{
    ViewData["Title"] = "Liveness Check";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4 text-dark">Health Check - /health/live</h2>

    <div class="card shadow-sm border-0 rounded-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 30%;" class="ps-3">Metric / Indicator</th>
                        <th style="width: 30%;">Status / Value</th>
                        <th style="width: 40%;">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- 1. Trạng thái ứng dụng -->
                    <tr>
                        <td class="ps-3 fw-medium">Application Status</td>
                        <td>
                            <span class="badge bg-success px-3 py-1.5 rounded-2">@ViewBag.LiveStatus</span>
                        </td>
                        <td class="text-secondary">The application process is responsive and running.</td>
                    </tr>
                    <!-- 2. Thời gian đã chạy liên tục -->
                    <tr>
                        <td class="ps-3 fw-medium">Uptime</td>
                        <td>
                            <span class="text-dark fw-bold">@ViewBag.Uptime</span>
                        </td>
                        <td class="text-secondary">Time elapsed since the application started.</td>
                    </tr>
                    <!-- 3. Bộ nhớ RAM đang sử dụng -->
                    <tr>
                        <td class="ps-3 fw-medium">Memory Allocation</td>
                        <td>
                            <span class="badge bg-info text-dark px-3 py-1.5 rounded-2">@ViewBag.MemoryUsage</span>
                        </td>
                        <td class="text-secondary">Current private memory size allocated by OS.</td>
                    </tr>
                    <!-- 4. Môi trường triển khai -->
                    <tr>
                        <td class="ps-3 fw-medium">Environment</td>
                        <td>
                            <span class="text-uppercase text-muted fw-semibold">@ViewBag.Environment</span>
                        </td>
                        <td class="text-secondary">The hosting environment hosting the application.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>