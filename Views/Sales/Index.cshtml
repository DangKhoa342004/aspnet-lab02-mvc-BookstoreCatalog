@model List<BookstoreCatalog.Mvc.Models.Sale>

@{
    ViewData["Title"] = "Sales List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Sales List</h2>
        <a asp-action="Create" class="btn btn-primary font-weight-bold">Create New Sale</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-box">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card card-custom">
        <table class="table table-hover mb-0">
            <thead class="table-header-dark">
                <tr>
                    <th>Sale ID</th>
                    <th>Customer Name</th>
                    <th>Book Name</th>
                    <th>Ngày tạo</th>
                    <th>Tổng tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var sale in Model)
                    {
                        <tr>
                            <td class="font-weight-bold">#@sale.Id</td>
                            <td>@sale.CustomerName</td>
                            <td>
                                @if (sale.SaleItems != null && sale.SaleItems.Any())
                                {
                                    @string.Join(", ", sale.SaleItems.Select(i => i.Book?.Title ?? "Không rõ"))
                                }
                                else
                                {
                                    <span class="text-muted">Không có sách</span>
                                }
                            </td>
                            <td>@sale.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-primary font-weight-bold">@sale.TotalAmount.ToString("N0") VND</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có đơn hàng nào trong hệ thống.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>