@model BookListViewModel

<div class="book-card">
    <h3>@Model.Title</h3>

    <p class="book-meta">
        Tác giả: @Model.Author
    </p>

    <p class="book-meta">
        Thể loại: @Model.GenreName
    </p>

    <p class="book-price">
        @Model.PriceText
    </p>

    <p>
        Số lượng: <strong>@Model.Stock  </strong>
    </p>

    <p>
        ISBN: <strong>@Model.ISBN</strong>
    </p>

    <div class="card-actions">
        <a class="btn btn-light"
           asp-controller="Books"
           asp-action="Detail"
           asp-route-id="@Model.Id">
            Xem
        </a>
    </div>
</div>