<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookstoreCatalog.Mvc</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <header class="site-header">
        <div class="container header-content">
            <div class="brand">
                <a asp-controller="Home" asp-action="Index">BookstoreCatalog.Mvc</a>
            </div>

            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">Dashboard</a>
                <a asp-controller="Books" asp-action="Index">Books</a>
                <a asp-controller="Books" asp-action="Stats">Stats</a>
                <a asp-controller="Books" asp-action="Search">Search</a>
                <a asp-controller="Books" asp-action="Create">Create</a>
                <a asp-controller="Sales" asp-action="Index">Sales</a>
                <a asp-controller="Books" asp-action="Trash">Trash</a>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-danger fw-bold" asp-controller="AuditLogs" asp-action="Index">Audit Logs</a>
                    </li>                                
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-info fw-bold" href="#" id="healthDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Hệ thống & APIs
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="healthDropdown">
                            <li><a class="dropdown-item" href="/health/ready" target="_blank">Health Check UI</a></li>
                            <li><a class="dropdown-item" href="/api/books/9999" target="_blank">Test API Error (Raw JSON)</a></li>
                        </ul>
                    </li>
                }
                @await Html.PartialAsync("_LoginPartial")
                </div>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <span>&copy; 2026 - BookstoreCatalog.Mvc - Lab06</span>
            <a href="#">Privacy</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>