<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookstoreCatalog.Mvc</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-content">
            <div class="brand">
                <a asp-controller="Home" asp-action="Index">BookstoreCatalog.Mvc</a>
            </div>

            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Books" asp-action="Index">Books</a>
                <a asp-controller="Genres" asp-action="Index">Genres</a>
                <a asp-controller="Sales" asp-action="Index">Sales</a>
                <a asp-controller="DataHealth" asp-action="Index">Data Health</a>
                <a asp-controller="Sales" asp-action="Create">Create Sale</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <span>&copy; 2026 - BookstoreCatalog.Mvc - Lab04</span>
            <a href="#">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>