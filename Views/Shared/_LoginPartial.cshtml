@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
        var roleString = roles.Any() ? $"({string.Join(", ", roles)})" : "";

        <li class="nav-item">
            <span class="nav-link text-dark fw-bold me-3">
                Hello, @User.Identity?.Name <span class="text-secondary small">@roleString</span>
            </span>
        </li>
            
        <li class="nav-item">
            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-danger btn-sm px-3">Đăng xuất</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-success text-white px-3 btn-sm" asp-controller="Account" asp-action="Login">Đăng nhập</a>
        </li>
    }
</ul>