@using Microsoft.AspNetCore.Identity
@using BookstoreCatalog.Mvc.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
    var roleString = roles.Any() ? $"({string.Join(", ", roles)})" : "";

    <span class="nav-text text-white fw-bold me-2" style="font-size: 0.9rem;">
        Hello, @User.Identity?.Name <span class="text-secondary small">@roleString</span>
    </span>
        
    <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" style="font-size: 0.85rem;">Đăng xuất</button>
    </form>
}
else
{
    <a class="btn btn-success text-white btn-sm py-1 px-3" asp-controller="Account" asp-action="Login">Đăng nhập</a>
}